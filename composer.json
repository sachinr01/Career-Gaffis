{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-translation-manager": "^0.6.9",
        "cviebrock/eloquent-sluggable": "^12.0",
        "doctrine/dbal": "^4.0",
        "froiden/envato": "^5.3",
        "froiden/laravel-installer": "^11.0",
        "froiden/laravel-rest-api": "^13.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.7",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "laravel/nexmo-notification-channel": "^3.5",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^3.1.67",
        "nekhbet/laravel-collective-html": "^1.0",
        "nwidart/laravel-modules": "^12.0",
        "trebol/entrust": "^4.0",
        "tymon/jwt-auth": "^2.2",
        "yajra/laravel-datatables-buttons": "^12.0",
        "yajra/laravel-datatables-html": "^12.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "start.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
